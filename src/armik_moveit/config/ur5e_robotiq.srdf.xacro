<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description for the UR5e + Robotiq 2F-85 (Phase 2).

  Reuses ur_moveit_config's ur_srdf macro for the arm group (ur_manipulator),
  its named states, and its arm self-collision rules, then adds the gripper
  group, open/closed states, an end effector, and the 2F-85's internal collision
  disables (its fingers form a packed closed chain, so all attachment-and-gripper
  link pairs are disabled for self-collision checking).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e_robotiq">

  <!-- Arm: group ur_manipulator (base_link -> tool0), named states, arm collisions -->
  <xacro:include filename="$(find ur_moveit_config)/srdf/ur_macro.srdf.xacro"/>
  <xacro:ur_srdf/>

  <!-- The arm base rests on the pedestal stand -->
  <disable_collisions link1="pedestal" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="pedestal" link2="shoulder_link" reason="Never"/>

  <!-- Gripper group: the single actuated knuckle joint drives the 2F-85 -->
  <group name="gripper">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>
  <group_state name="open" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.8"/>
  </group_state>

  <!-- End effector: the gripper hangs off the arm's tool0 -->
  <end_effector name="gripper_eef" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>

  <!-- 2F-85 internal + attachment self-collision disables -->
    <disable_collisions link1="wrist_3_link" link2="flange" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="tool0" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="ur_to_robotiq_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="gripper_mount_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="wrist_3_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="flange" link2="tool0" reason="Never" />
    <disable_collisions link1="flange" link2="ur_to_robotiq_link" reason="Never" />
    <disable_collisions link1="flange" link2="gripper_mount_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="flange" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="tool0" link2="ur_to_robotiq_link" reason="Never" />
    <disable_collisions link1="tool0" link2="gripper_mount_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="tool0" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="gripper_mount_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_base_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="gripper_mount_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_link" reason="Never" />
    <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
