<?xml version="1.0" ?>
<!--
  Phase 3 perception world: the supply bin of the palletizing cell viewed by a
  downward RGB-D camera. Four coloured parts sit on the bin; a detector node
  segments them by colour and lifts them to 3D poses from the depth image, so
  the palletizer picks what it sees instead of hard-coded bin cells.

  Geometry is floor-referenced and matches scene.py's cell (bin centred at
  (0.47, -0.32), top z = 0.08; parts are 0.04 m cubes at z = 0.10).
-->
<sdf version="1.10">
  <world name="perception_cell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Supply bin (top at z = 0.08) -->
    <model name="supply_bin">
      <static>true</static>
      <pose>0.47 -0.32 0.04 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.26 0.24 0.08</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.26 0.24 0.08</size></box></geometry>
          <material><ambient>0.30 0.42 0.60 1</ambient><diffuse>0.30 0.42 0.60 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Four coloured parts on the bin (0.04 m cubes, centre z = 0.10) -->
    <model name="part_red">
      <pose>0.41 -0.38 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.85 0.10 0.10 1</ambient><diffuse>0.85 0.10 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="part_green">
      <pose>0.53 -0.38 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.10 0.70 0.15 1</ambient><diffuse>0.10 0.70 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="part_blue">
      <pose>0.41 -0.26 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.10 0.30 0.85 1</ambient><diffuse>0.10 0.30 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="part_yellow">
      <pose>0.53 -0.26 0.10 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.3e-5</ixx><iyy>1.3e-5</iyy><izz>1.3e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>0.90 0.75 0.10 1</ambient><diffuse>0.90 0.75 0.10 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Downward RGB-D camera over the bin. Raised and widened so the whole
         bin footprint stays in view even when parts are scattered to the edges. -->
    <model name="rgbd_camera">
      <static>true</static>
      <pose>0.47 -0.32 1.00 0 1.5707963 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <topic>rgbd_camera</topic>
          <camera>
            <horizontal_fov>1.2217</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>3.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
